          "startingLine": 81
        }
      },
      {
        "comment": "",
        "key": "Automatic injection is paused. Existing visible tabs update within a few seconds.",
        "location": {
          "startingColumn": 119,
          "startingLine": 81
        }
      },
      {
        "comment": "",
        "key": "⚙︎ DevTools",
        "location": {
          "startingColumn": 34,
          "startingLine": 67
        }
      },
      {
        "comment": "",
        "key": "Your web console. Everywhere you need it.",
