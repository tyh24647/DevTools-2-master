        }
      },
      {
        "comment": "",
        "key": "Active blacklists",
        "location": {
          "startingColumn": 27,
          "startingLine": 96
        }
      },
      {
        "comment": "",
        "key": "Page access",
        "location": {
          "startingColumn": 22,
          "startingLine": 102
        }
      },
      {
        "comment": "",
        "key": "Runs on permitted HTTP and HTTPS pages except matches in your selected blacklists.",
        "location": {
          "startingColumn": 51,
          "startingLine": 104
        }
      },
      {
        "comment": "",
        "key": "Runs only on pages matching a selected AllowList. Blacklists still take priority. An empty selection allows no pages.",
        "location": {
          "startingColumn": 138,
          "startingLine": 104
        }
      },
      {
        "comment": "",
        "key": "Enable in Safari",
        "location": {
          "startingColumn": 27,
          "startingLine": 110
        }
      },
      {
        "comment": "",
        "key": "How matching works",
        "location": {
          "startingColumn": 27,
          "startingLine": 115
        }
      },
      {
        "comment": "",
        "key": "Installed packages",
        "location": {
          "startingColumn": 27,
          "startingLine": 120
        }
      },
      {
        "comment": "",
        "key": "Vue inspector, resource waterfall, themes and more. No ads.",
        "location": {
          "startingColumn": 34,
          "startingLine": 134
        }
      },
      {
        "comment": "",
        "key": "DevTools Pro is active",
        "location": {
          "startingColumn": 48,
          "startingLine": 132
        }
      },
      {
        "comment": "",
        "key": "Make DevTools yours",
        "location": {
          "startingColumn": 75,
          "startingLine": 132
        }
      },
      {
        "comment": "",
        "key": "Safari setup",
        "location": {
          "startingColumn": 26,
          "startingLine": 171
        }
      },
      {
        "comment": "",
        "key": "Safari permission",
        "location": {
          "startingColumn": 21,
          "startingLine": 154
        }
      },
      {
        "comment": "",
        "key": "Share sheet actions",
        "location": {
          "startingColumn": 21,
          "startingLine": 160
        }
      },
      {
        "comment": "",
        "key": "What to expect",
        "location": {
          "startingColumn": 21,
          "startingLine": 165
        }
      },
      {
        "comment": "",
        "key": "Open Settings → Apps → Safari → Extensions.",
        "location": {
          "startingColumn": 23,
          "startingLine": 155
        }
      },
      {
        "comment": "",
        "key": "Choose ⚙︎ DevTools and turn on Allow Extension.",
        "location": {
          "startingColumn": 23,
          "startingLine": 156
        }
      },
      {
        "comment": "",
        "key": "Grant website access, including All Websites if you want automatic injection everywhere.",
        "location": {
          "startingColumn": 23,
          "startingLine": 157
        }
      },
      {
        "comment": "",
        "key": "Reload a page. Tap the floating console button or open Safari’s extension menu.",
        "location": {
          "startingColumn": 23,
          "startingLine": 158
        }
      },
      {
        "comment": "",
        "key": "In Safari, tap Share and scroll to the actions. Use Edit Actions to add the six DevTools actions to Favorites. iOS controls their ordering and may truncate long names.",
        "location": {
          "startingColumn": 22,
          "startingLine": 161
        }
      },
      {
        "comment": "",
        "key": "Show opens the current page’s console. Hide hides its panel and floating button. Enable and Disable change the global DevTools switch. Show still respects your lists and Safari permissions.",
        "location": {
          "startingColumn": 22,
          "startingLine": 162
        }
      },
      {
        "comment": "",
        "key": "Add to AllowList and Add to Blacklist let you choose a list and match type before saving. Changes apply to Safari as soon as the action closes.",
        "location": {
          "startingColumn": 22,
          "startingLine": 163
        }
      },
      {
        "comment": "",
        "key": "Safari cannot inject into its own settings pages, reader internals or protected browser pages. Permission can also be limited by website or Safari profile.",
        "location": {
          "startingColumn": 22,
          "startingLine": 166
        }
      },
      {
        "comment": "",
        "key": "The extension starts as early as Safari allows. Requests or logs created before it starts may not be captured. The resource waterfall also reads buffered Performance entries.",
        "location": {
          "startingColumn": 22,
          "startingLine": 167
        }
      },
      {
        "comment": "",
        "key": "Vue tools work best on development builds with DevTools hooks available. Some production apps remove those hooks; no extension can guarantee inspecting every Vue app.",
        "location": {
          "startingColumn": 22,
          "startingLine": 168
        }
      },
      {
        "comment": "",
        "key": "Matching guide",
        "location": {
          "startingColumn": 26,
          "startingLine": 196
        }
      },
      {
        "comment": "",
        "key": "Priority",
        "location": {
          "startingColumn": 21,
          "startingLine": 178
        }
      },
      {
        "comment": "",
        "key": "Examples",
        "location": {
          "startingColumn": 21,
          "startingLine": 181
        }
      },
      {
        "comment": "",
        "key": "Lists",
        "location": {
          "startingColumn": 21,
          "startingLine": 191
        }
      },
      {
        "comment": "",
        "key": "1. Disabled means do not run.\n2. A match in any selected blacklist means do not run.\n3. Run on every webpage allows remaining pages.\n4. Otherwise, a selected AllowList must match.",
        "location": {
          "startingColumn": 22,
          "startingLine": 179
        }
      },
      {
        "comment": "",
        "key": "Matches example.com and api.example.com, but never notexample.com.",
        "location": {
          "startingColumn": 22,
          "startingLine": 183
        }
      },
      {
        "comment": "",
        "key": "Matches the full URL including its query string. Fragments are ignored.",
        "location": {
          "startingColumn": 22,
          "startingLine": 185
        }
      },
      {
        "comment": "",
        "key": "* matches any sequence; ? matches one character. A wildcard is anchored to the entire URL and is case sensitive. *.example.com does not include the bare example.com host.",
        "location": {
          "startingColumn": 22,
          "startingLine": 187
        }
      },
      {
        "comment": "",
        "key": "Use JavaScript regex syntax with optional /pattern/imu flags. Matching uses the normalized URL without its fragment. Patterns are limited to 512 characters, URLs to 4096. Backreferences, lookarounds, repeated complex groups and more than four variable-length repetitions are rejected.",
        "location": {
          "startingColumn": 22,
          "startingLine": 189
        }
      },
      {
        "comment": "",
        "key": "Domain & subdomains",
        "location": {
          "startingColumn": 32,
          "startingLine": 182
        }
      },
      {
        "comment": "",
        "key": "Exact URL",
        "location": {
          "startingColumn": 32,
          "startingLine": 184
        }
      },
      {
        "comment": "",
        "key": "Wildcard",
        "location": {
          "startingColumn": 32,
          "startingLine": 186
        }
      },
      {
        "comment": "",
        "key": "Regular expression",
        "location": {
          "startingColumn": 32,
          "startingLine": 188
        }
      },
      {
        "comment": "",
        "key": "Select several lists to combine them. Unselected lists do not affect matching. An invalid active rule stops injection and is reported in the Safari popup.",
        "location": {
          "startingColumn": 22,
          "startingLine": 192
        }
      }
    ]
  },
